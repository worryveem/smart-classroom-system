{
    "model": "RandomForestClassifier",
    "features": [
        "temp_mean",
        "light_mean",
        "pir_active",
        "hour"
    ],
    "labels": [
        "EMPTY",
        "LOW",
        "CROWDED"
    ],
    "occupancy_mapping": {
        "0": "EMPTY",
        "1": "LOW",
        "2-3": "CROWDED"
    },
    "parameters": {
        "n_estimators": 300,
        "max_depth": null,
        "min_samples_split": 2,
        "min_samples_leaf": 1,
        "class_weight": "balanced",
        "random_state": 42
    },
    "test_size": 0.2,
    "split_method": "stratified_random_split",
    "sklearn_version": "1.6.1"
}